// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Aquí agregamos el modelo Product
model Product {
  id        Int      @id @default(autoincrement()) // Clave primaria que se autoincrementa
  name      String   // Nombre del producto
  price     Float    // Precio del producto
  createdAt DateTime @default(now()) // Fecha de creación automática
  updatedAt DateTime @updatedAt // Fecha de la última actualización automática
}
